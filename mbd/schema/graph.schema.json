{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypraccel.dev/schemas/mbd/graph-v1.schema.json",
  "title": "HyprAccel MBD graph V1",
  "description": "On-disk representation of a HyprAccel model-based design graph. Port existence and edge type compatibility are validated against mbd/nodes/node_spec.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "nodes", "edges"],
  "properties": {
    "format": { "const": "hypraccel.mbd.graph" },
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "inputs": {
      "description": "Optional host-supplied graph inputs. An unconnected node input may name one of these bindings in editor metadata.",
      "type": "array",
      "items": { "$ref": "#/$defs/graphInput" },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "graphInput": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["number", "boolean", "vector<number>", "pose", "any"] },
        "unit": { "type": "string" }
      }
    },
    "nodeBase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["SensorInput", "CordicOp", "KinematicsSolve", "ControlLoop", "ActuatorOutput", "Publish"] },
        "label": { "type": "string", "minLength": 1 },
        "params": { "type": "object" },
        "position": {
          "type": "object", "additionalProperties": false,
          "required": ["x", "y"],
          "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
        }
      }
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/sensorInputNode" },
        { "$ref": "#/$defs/cordicNode" },
        { "$ref": "#/$defs/kinematicsNode" },
        { "$ref": "#/$defs/controlLoopNode" },
        { "$ref": "#/$defs/actuatorOutputNode" },
        { "$ref": "#/$defs/publishNode" }
      ]
    },
    "sensorInputNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "SensorInput" }, "params": { "type": "object", "additionalProperties": false, "required": ["source", "valueType", "samplePeriodUs"], "properties": { "source": { "type": "string", "minLength": 1 }, "valueType": { "enum": ["number", "boolean", "vector<number>", "pose", "any"] }, "samplePeriodUs": { "type": "integer", "minimum": 1 }, "unit": { "type": "string" } } } } }]
    },
    "cordicNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "CordicOp" }, "params": { "type": "object", "additionalProperties": false, "required": ["operation"], "properties": { "operation": { "enum": ["sin", "cos", "sincos", "atan2"] }, "implementation": { "enum": ["auto", "software", "hardware"] }, "iterations": { "type": "integer", "minimum": 1, "maximum": 32 } } } } }]
    },
    "kinematicsNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "KinematicsSolve" }, "params": { "type": "object", "additionalProperties": false, "required": ["mode", "robotModel"], "properties": { "mode": { "enum": ["forward", "inverse"] }, "robotModel": { "type": "string", "minLength": 1 }, "maxIterations": { "type": "integer", "minimum": 1 }, "tolerance": { "type": "number", "exclusiveMinimum": 0 } } } } }]
    },
    "controlLoopNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "ControlLoop" }, "params": { "type": "object", "additionalProperties": false, "required": ["kp", "ki", "kd", "samplePeriodUs", "outputMin", "outputMax"], "properties": { "kp": { "type": "number" }, "ki": { "type": "number" }, "kd": { "type": "number" }, "samplePeriodUs": { "type": "integer", "minimum": 1 }, "outputMin": { "type": "number" }, "outputMax": { "type": "number" }, "initialOutput": { "type": "number" } } } } }]
    },
    "actuatorOutputNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "ActuatorOutput" }, "params": { "type": "object", "additionalProperties": false, "required": ["target", "unit", "min", "max"], "properties": { "target": { "type": "string", "minLength": 1 }, "unit": { "type": "string", "minLength": 1 }, "min": { "type": "number" }, "max": { "type": "number" }, "safeValue": { "type": "number" } } } } }]
    },
    "publishNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "Publish" }, "params": { "type": "object", "additionalProperties": false, "required": ["topic", "transport"], "properties": { "topic": { "type": "string", "minLength": 1 }, "transport": { "enum": ["telemetry", "log", "host"] }, "retain": { "type": "boolean" } } } } }]
    },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["node", "port"],
      "properties": {
        "node": { "$ref": "#/$defs/identifier" },
        "port": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" }
      }
    }
  }
}
