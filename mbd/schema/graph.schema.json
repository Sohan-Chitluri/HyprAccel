{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypraccel.dev/schemas/mbd/graph-v1.schema.json",
  "title": "HyprAccel MBD graph V1",
  "description": "On-disk representation of a HyprAccel model-based design graph. Port existence and edge type compatibility are validated against mbd/nodes/node_spec.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "nodes", "edges"],
  "properties": {
    "format": { "const": "hypraccel.mbd.graph" },
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "inputs": {
      "description": "Optional host-supplied graph inputs. An unconnected node input may name one of these bindings in editor metadata.",
      "type": "array",
      "items": { "$ref": "#/$defs/graphInput" },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "hardwareResourceId": { "type": "string", "pattern": "^(gpio|uart|spi|i2c|pwm|adc|accelerator|encoder|motor)\\\\.[A-Za-z0-9_-]+$" },
    "graphInput": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["number", "boolean", "vector<number>", "pose", "any"] },
        "unit": { "type": "string" }
      }
    },
    "nodeBase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["SensorInput", "CordicOp", "KinematicsSolve", "ControlLoop", "ActuatorOutput", "Publish", "Constant", "Add", "Subtract", "Multiply", "Gain", "Compare", "Saturation", "Switch", "Time", "CustomCode", "GPIOInput", "ADCInput", "PWMOutput", "UARTInput", "UARTOutput", "EncoderInput", "MotorOutput", "WheelSpeed", "DifferentialDrive"] },
        "label": { "type": "string", "minLength": 1 },
        "params": { "type": "object" },
        "position": {
          "type": "object", "additionalProperties": false,
          "required": ["x", "y"],
          "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
        }
      }
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/sensorInputNode" },
        { "$ref": "#/$defs/cordicNode" },
        { "$ref": "#/$defs/kinematicsNode" },
        { "$ref": "#/$defs/controlLoopNode" },
        { "$ref": "#/$defs/actuatorOutputNode" },
        { "$ref": "#/$defs/publishNode" },
        { "$ref": "#/$defs/constantNode" },
        { "$ref": "#/$defs/addNode" },
        { "$ref": "#/$defs/subtractNode" },
        { "$ref": "#/$defs/multiplyNode" },
        { "$ref": "#/$defs/gainNode" },
        { "$ref": "#/$defs/compareNode" },
        { "$ref": "#/$defs/saturationNode" },
        { "$ref": "#/$defs/switchNode" },
        { "$ref": "#/$defs/timeNode" },
        { "$ref": "#/$defs/customCodeNode" },
        { "$ref": "#/$defs/gpioInputNode" },
        { "$ref": "#/$defs/adcInputNode" },
        { "$ref": "#/$defs/pwmOutputNode" },
        { "$ref": "#/$defs/uartInputNode" },
        { "$ref": "#/$defs/uartOutputNode" },
        { "$ref": "#/$defs/encoderInputNode" },
        { "$ref": "#/$defs/motorOutputNode" },
        { "$ref": "#/$defs/wheelSpeedNode" },
        { "$ref": "#/$defs/differentialDriveNode" }
      ]
    },
    "sensorInputNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "SensorInput" }, "params": { "type": "object", "additionalProperties": false, "required": ["source", "valueType", "samplePeriodUs"], "properties": { "source": { "type": "string", "minLength": 1 }, "valueType": { "enum": ["number", "boolean", "vector<number>", "pose", "any"] }, "samplePeriodUs": { "type": "integer", "minimum": 1 }, "unit": { "type": "string" }, "hardwareResource": { "$ref": "#/$defs/hardwareResourceId" } } } } }]
    },
    "cordicNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "CordicOp" }, "params": { "type": "object", "additionalProperties": false, "required": ["operation"], "properties": { "operation": { "enum": ["sin", "cos", "sincos", "atan2"] }, "implementation": { "enum": ["auto", "software", "hardware"] }, "iterations": { "type": "integer", "minimum": 1, "maximum": 32 }, "hardwareResource": { "$ref": "#/$defs/hardwareResourceId" } } } } }]
    },
    "kinematicsNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "KinematicsSolve" }, "params": { "type": "object", "additionalProperties": false, "required": ["mode", "robotModel"], "properties": { "mode": { "enum": ["forward", "inverse"] }, "robotModel": { "type": "string", "minLength": 1 }, "maxIterations": { "type": "integer", "minimum": 1 }, "tolerance": { "type": "number", "exclusiveMinimum": 0 } } } } }]
    },
    "controlLoopNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "ControlLoop" }, "params": { "type": "object", "additionalProperties": false, "required": ["kp", "ki", "kd", "samplePeriodUs", "outputMin", "outputMax"], "properties": { "kp": { "type": "number" }, "ki": { "type": "number" }, "kd": { "type": "number" }, "samplePeriodUs": { "type": "integer", "minimum": 1 }, "outputMin": { "type": "number" }, "outputMax": { "type": "number" }, "initialOutput": { "type": "number" } } } } }]
    },
    "actuatorOutputNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "ActuatorOutput" }, "params": { "type": "object", "additionalProperties": false, "required": ["target", "unit", "min", "max"], "properties": { "target": { "type": "string", "minLength": 1 }, "unit": { "type": "string", "minLength": 1 }, "min": { "type": "number" }, "max": { "type": "number" }, "safeValue": { "type": "number" }, "hardwareResource": { "$ref": "#/$defs/hardwareResourceId" } } } } }]
    },
    "publishNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "Publish" }, "params": { "type": "object", "additionalProperties": false, "required": ["topic", "transport"], "properties": { "topic": { "type": "string", "minLength": 1 }, "transport": { "enum": ["telemetry", "log", "host"] }, "retain": { "type": "boolean" } } } } }]
    },
    "constantNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "Constant" }, "params": { "type": "object", "additionalProperties": false, "required": ["value"], "properties": { "value": { "type": "number" } } } } }]
    },
    "addNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "Add" }, "params": { "type": "object", "additionalProperties": false } } }]
    },
    "subtractNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "Subtract" }, "params": { "type": "object", "additionalProperties": false } } }]
    },
    "multiplyNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "Multiply" }, "params": { "type": "object", "additionalProperties": false } } }]
    },
    "gainNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "Gain" }, "params": { "type": "object", "additionalProperties": false, "required": ["gain"], "properties": { "gain": { "type": "number" } } } } }]
    },
    "compareNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "Compare" }, "params": { "type": "object", "additionalProperties": false, "required": ["operation"], "properties": { "operation": { "enum": ["gt", "lt", "ge", "le", "eq", "ne"] }, "threshold": { "type": "number" } } } } }]
    },
    "saturationNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "Saturation" }, "params": { "type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": { "min": { "type": "number" }, "max": { "type": "number" } } } } }]
    },
    "switchNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "Switch" }, "params": { "type": "object", "additionalProperties": false } } }]
    },
    "timeNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "Time" }, "params": { "type": "object", "additionalProperties": false } } }]
    },
    "customCodeNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "CustomCode" }, "params": { "type": "object", "additionalProperties": false, "required": ["inputs", "code"], "properties": { "inputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }, "code": { "type": "string" } } } } }]
    },
    "gpioInputNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "GPIOInput" }, "params": { "type": "object", "additionalProperties": false, "required": ["hardwareResource"], "properties": { "hardwareResource": { "type": "string", "pattern": "^gpio\\.[A-Za-z0-9_-]+$" }, "samplePeriodUs": { "type": "integer", "minimum": 1 }, "invert": { "type": "boolean" } } } } }]
    },
    "adcInputNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "ADCInput" }, "params": { "type": "object", "additionalProperties": false, "required": ["hardwareResource"], "properties": { "hardwareResource": { "type": "string", "pattern": "^adc\\.[A-Za-z0-9_-]+$" }, "samplePeriodUs": { "type": "integer", "minimum": 1 }, "unit": { "type": "string" }, "minValue": { "type": "number" }, "maxValue": { "type": "number" } } } } }]
    },
    "pwmOutputNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "PWMOutput" }, "params": { "type": "object", "additionalProperties": false, "required": ["hardwareResource", "min", "max"], "properties": { "hardwareResource": { "type": "string", "pattern": "^pwm\\.[A-Za-z0-9_-]+$" }, "min": { "type": "number" }, "max": { "type": "number" }, "unit": { "type": "string" }, "safeValue": { "type": "number" } } } } }]
    },
    "uartInputNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "UARTInput" }, "params": { "type": "object", "additionalProperties": false, "required": ["hardwareResource", "samplePeriodUs"], "properties": { "hardwareResource": { "type": "string", "pattern": "^uart\\.[A-Za-z0-9_-]+$" }, "samplePeriodUs": { "type": "integer", "minimum": 1 }, "baudRate": { "type": "integer", "minimum": 300, "maximum": 1000000 }, "dataBits": { "type": "integer", "enum": [5, 6, 7, 8] }, "parity": { "type": "string", "enum": ["none", "even", "odd"] }, "stopBits": { "type": "integer", "enum": [1, 2] } } } } }]
    },
    "uartOutputNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "UARTOutput" }, "params": { "type": "object", "additionalProperties": false, "required": ["hardwareResource"], "properties": { "hardwareResource": { "type": "string", "pattern": "^uart\\.[A-Za-z0-9_-]+$" }, "baudRate": { "type": "integer", "minimum": 300, "maximum": 1000000 }, "dataBits": { "type": "integer", "enum": [5, 6, 7, 8] }, "parity": { "type": "string", "enum": ["none", "even", "odd"] }, "stopBits": { "type": "integer", "enum": [1, 2] } } } } }]
    },
    "encoderInputNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "EncoderInput" }, "params": { "type": "object", "additionalProperties": false, "required": ["hardwareResource", "samplePeriodUs"], "properties": { "hardwareResource": { "type": "string", "pattern": "^encoder\\.[A-Za-z0-9_-]+$" }, "samplePeriodUs": { "type": "integer", "minimum": 1 }, "pulsesPerRevolution": { "type": "integer", "minimum": 1 }, "quadrature": { "type": "boolean" } } } } }]
    },
    "motorOutputNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "MotorOutput" }, "params": { "type": "object", "additionalProperties": false, "required": ["hardwareResource", "min", "max"], "properties": { "hardwareResource": { "type": "string", "pattern": "^motor\\.[A-Za-z0-9_-]+$" }, "min": { "type": "number" }, "max": { "type": "number" }, "unit": { "type": "string" }, "safeValue": { "type": "number" } } } } }]
    },
    "wheelSpeedNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "WheelSpeed" }, "params": { "type": "object", "additionalProperties": false, "required": ["pulsesPerRevolution", "wheelRadiusMeters"], "properties": { "pulsesPerRevolution": { "type": "integer", "minimum": 1 }, "wheelRadiusMeters": { "type": "number", "exclusiveMinimum": 0 } } } } }]
    },
    "differentialDriveNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }, { "properties": { "type": { "const": "DifferentialDrive" }, "params": { "type": "object", "additionalProperties": false, "required": ["trackWidthMeters"], "properties": { "trackWidthMeters": { "type": "number", "exclusiveMinimum": 0 } } } } }]
    },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["node", "port"],
      "properties": {
        "node": { "$ref": "#/$defs/identifier" },
        "port": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" }
      }
    }
  }
}
