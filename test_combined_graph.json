{
  "format": "hypraccel.mbd.graph",
  "version": 1,
  "id": "combined_test_graph",
  "name": "Combined Sensor-Actuator Test",
  "nodes": [
    {
      "id": "sensor1",
      "type": "SensorInput",
      "label": "ADC Sensor",
      "params": {
        "source": "adc.channel0",
        "valueType": "number",
        "samplePeriodUs": 10000,
        "unit": "V",
        "hardwareResource": "adc.channel0"
      },
      "position": { "x": 100, "y": 100 }
    },
    {
      "id": "cordic1",
      "type": "CordicOp",
      "label": "Sine Processor",
      "params": {
        "operation": "sin",
        "implementation": "software",
        "iterations": 16
      },
      "position": { "x": 100, "y": 250 }
    },
    {
      "id": "publish1",
      "type": "Publish",
      "label": "Sensor Telemetry",
      "params": {
        "topic": "telemetry/sensor/adc0",
        "transport": "telemetry",
        "retain": false
      },
      "position": { "x": 400, "y": 100 }
    },
    {
      "id": "actuator1",
      "type": "ActuatorOutput",
      "label": "PWM Motor",
      "params": {
        "target": "joint1.motor",
        "unit": "rad/s",
        "min": -1,
        "max": 1,
        "safeValue": 0,
        "hardwareResource": "pwm.motor0"
      },
      "position": { "x": 400, "y": 250 }
    }
  ],
  "edges": [
    {
      "id": "edge1",
      "from": { "node": "sensor1", "port": "value" },
      "to": { "node": "publish1", "port": "value" }
    },
    {
      "id": "edge2",
      "from": { "node": "cordic1", "port": "value" },
      "to": { "node": "actuator1", "port": "command" }
    }
  ],
  "inputs": [
    {
      "name": "angle_rad",
      "type": "number",
      "unit": "rad"
    }
  ],
  "metadata": {
    "externalBindings": [
      {
        "input": "angle_rad",
        "to": { "node": "cordic1", "port": "angle_rad" }
      }
    ]
  }
}